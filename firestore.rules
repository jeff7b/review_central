rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny all client-side access.
    // All application data access goes through the Firebase Admin SDK
    // (server actions), which bypasses these rules. These rules are
    // defense-in-depth against unauthorized direct client access.
    match /{document=**} {
      allow read, write: if false;
    }

    // Questionnaires: any authenticated user may read (needed to complete reviews).
    // Writes go through Admin SDK only.
    match /questionnaires/{id} {
      allow read: if request.auth != null;
    }

    // Review cycles: any authenticated user may read.
    // Writes go through Admin SDK only.
    match /review-cycles/{id} {
      allow read: if request.auth != null;
    }

    // Users, peer-review-assignments, and peer-reviews are sensitive.
    // All access is restricted to the Admin SDK (server actions).
    // No direct client-side read or write is permitted.
  }
}
